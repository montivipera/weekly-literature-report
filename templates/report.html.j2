<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ subject }}</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #f4f3ee;
    --bg-card: #ffffff;
    --border: #e3e0d8;
    --text: #1a1d1f;
    --text-muted: #6a6a65;
    --text-faint: #9a9890;
    --accent: #0f4c5c;
    --accent-soft: #d8e4e7;
    --d-molecular:      #be185d;
    --d-ecology:        #15803d;
    --d-hydrology:      #0369a1;
    --d-remote_sensing: #7c3aed;
    --d-synthesis:      #0d9488;
    --d-policy:         #b45309;
    --d-other:          #6b7280;
  }

  html, body {
    background: var(--bg);
    background-image:
      radial-gradient(ellipse at top left, rgba(15, 76, 92, 0.05), transparent 50%),
      radial-gradient(ellipse at bottom right, rgba(180, 83, 9, 0.04), transparent 50%);
    background-attachment: fixed;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    line-height: 1.5;
  }

  .layout {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding: 32px;
    gap: 18px;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 32px;
    padding: 8px 4px 24px;
    border-bottom: 1px solid var(--border);
  }
  .hero-left .eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .hero-left h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 40px;
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }
  .hero-left h1 em {
    font-style: italic;
    color: var(--accent);
  }
  .hero-right {
    display: flex;
    gap: 24px;
    padding-bottom: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .stat { text-align: right; }
  .stat strong {
    font-family: Georgia, serif;
    font-size: 26px;
    font-weight: 400;
    display: block;
    line-height: 1;
    margin-bottom: 4px;
  }
  .stat span {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-faint);
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .hero { grid-template-columns: 1fr; }
    .hero-right { justify-content: flex-start; }
    .hero-left h1 { font-size: 30px; }
  }

  /* QUERY BAR */
  .query-bar {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 14px 4px 6px;
    flex-wrap: wrap;
  }
  .query-label {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-faint);
    padding-top: 6px;
    flex-shrink: 0;
    min-width: 90px;
  }
  .query-tokens {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    align-items: center;
    line-height: 1.8;
  }
  .qtoken {
    display: inline-flex;
    padding: 3px 9px;
    border-radius: 3px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
    font-size: 11.5px;
    border: 1px solid rgba(15, 76, 92, 0.18);
  }
  .qtoken.primary {
    background: var(--accent);
    color: #fff;
  }
  .qtoken.phrase::before { content: "“"; opacity: 0.6; margin-right: 1px; }
  .qtoken.phrase::after  { content: "”"; opacity: 0.6; margin-left: 1px; }
  .qop {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-faint);
    padding: 0 2px;
  }
  .qparen {
    color: var(--text-faint);
    font-size: 14px;
    padding: 0 1px;
  }

  /* CATEGORY HEADER */
  .category-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 4px 4px 12px;
    margin-top: 8px;
    border-bottom: 2px solid var(--text);
  }
  .category-header h2 {
    font-family: Georgia, serif;
    font-size: 22px;
    font-weight: 400;
  }
  .category-header .count {
    margin-left: auto;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-faint);
    font-weight: 600;
  }

  /* FILTER BAR */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 12px 4px 0;
  }
  .domain-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px 7px 10px;
    border-radius: 4px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
  }
  .domain-pill:hover {
    transform: translateY(-1px);
    border-color: var(--dc);
    box-shadow: 0 4px 12px rgba(15, 29, 36, 0.06);
  }
  .domain-pill .icon { font-size: 14px; line-height: 1; }
  .domain-pill .num {
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    margin-left: 2px;
  }

  /* DOMAIN SECTION */
  .domain { margin-top: 12px; }
  .domain-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 4px 14px;
  }
  .domain-header .icon { font-size: 22px; line-height: 1; }
  .domain-header h3 {
    font-family: Georgia, serif;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: -0.005em;
  }
  .domain-header .accent-line {
    flex: 1;
    height: 2px;
    background: linear-gradient(90deg, var(--dc) 0%, var(--dc) 30%, transparent 100%);
    border-radius: 1px;
  }
  .domain-header .num {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--dc);
    font-weight: 700;
  }

  /* GRID */
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(200px, auto);
    gap: 14px;
  }
  .grid .card.featured {
    grid-column: span 2;
    grid-row: span 2;
  }
  .grid .card.wide {
    grid-column: span 2;
  }
  @media (max-width: 1100px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 800px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .grid .card.featured { grid-column: span 2; grid-row: span 1; }
    .grid .card.wide { grid-column: span 2; }
  }
  @media (max-width: 540px) {
    .grid { grid-template-columns: 1fr; }
    .grid .card.featured, .grid .card.wide {
      grid-column: span 1;
      grid-row: span 1;
    }
  }

  /* CARD */
  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 3px;
    background: var(--dc);
    transition: width 0.18s;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(15, 29, 36, 0.08);
    border-color: var(--dc);
  }
  .card:hover::before { width: 5px; }
  .card.featured {
    background:
      linear-gradient(135deg, rgba(0,0,0,0.02), transparent 70%),
      var(--bg-card);
  }

  .card-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }
  .pill-domain {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 3px;
    background: rgba(0,0,0,0.06);
    color: var(--dc);
    line-height: 1;
  }
  .pill-domain .icon { font-size: 10px; }
  .pill-type {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 7px;
    border-radius: 3px;
    background: #f1eee8;
    color: var(--text-muted);
    line-height: 1;
  }
  .meta {
    font-size: 11px;
    color: var(--text-faint);
  }
  .meta::before { content: "·"; margin: 0 6px; color: #d0ccc2; }

  .card-title {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.005em;
    font-size: 15.5px;
    color: var(--text);
  }
  .card.featured .card-title { font-size: 22px; line-height: 1.2; }
  .card.wide .card-title { font-size: 17px; }

  .card-authors {
    font-size: 11.5px;
    color: var(--text-muted);
    font-style: italic;
  }

  .section { margin-top: 2px; }
  .section .label {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dc);
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .section .label::before {
    content: "";
    width: 10px;
    height: 1px;
    background: var(--dc);
  }
  .section ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 12.5px;
    color: var(--text);
    line-height: 1.45;
  }
  .section li {
    position: relative;
    padding-left: 12px;
    margin-bottom: 3px;
  }
  .section li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 7px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--dc);
    opacity: 0.55;
  }
  .card.featured .section ul { font-size: 13.5px; }

  .placeholder {
    color: var(--text-faint);
    font-style: italic;
    font-size: 11.5px;
  }

  .card-spacer { flex: 1; }
  .doi {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid #f0eee8;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 10.5px;
  }
  .doi a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px dotted var(--accent-soft);
    word-break: break-all;
  }
  .doi a::after { content: " ↗"; }

  /* Domain accent variable */
  .molecular      { --dc: var(--d-molecular); }
  .ecology        { --dc: var(--d-ecology); }
  .hydrology      { --dc: var(--d-hydrology); }
  .remote_sensing { --dc: var(--d-remote_sensing); }
  .synthesis      { --dc: var(--d-synthesis); }
  .policy         { --dc: var(--d-policy); }

  .empty-note {
    background: var(--bg-card);
    border: 1px dashed var(--border);
    border-radius: 6px;
    padding: 32px;
    text-align: center;
    color: var(--text-muted);
    font-size: 14px;
    margin-top: 16px;
  }

  footer {
    text-align: center;
    color: var(--text-faint);
    font-size: 11px;
    font-family: Georgia, serif;
    font-style: italic;
    padding: 24px 0 8px;
    border-top: 1px solid var(--border);
    margin-top: 12px;
  }
</style>
</head>
<body>
<div class="layout">

  <!-- HERO -->
  <header class="hero">
    <div class="hero-left">
      <div class="eyebrow">Weekly Literature Report · Week {{ iso_week }}</div>
      <h1>What's new this week<br>across <em>your watchlist</em>.</h1>
    </div>
    <div class="hero-right">
      <div class="stat"><strong>{{ total_count }}</strong><span>Articles</span></div>
      <div class="stat"><strong>{{ domain_count }}</strong><span>Domain{% if domain_count != 1 %}s{% endif %}</span></div>
      <div class="stat"><strong>{{ sources_count }}</strong><span>Sources</span></div>
      <div class="stat"><strong>{{ since_str }}–{{ until_str }}</strong><span>Window</span></div>
    </div>
  </header>

  {% if categories %}

  {% for cat in categories %}
  <!-- QUERY BAR for this category -->
  {% if cat.query_tokens %}
  <div class="query-bar">
    <span class="query-label">Search query</span>
    <div class="query-tokens">
      {% for tok in cat.query_tokens %}
        {% if tok.kind == "term" %}
          <span class="qtoken{% if tok.primary %} primary{% endif %}{% if tok.phrase %} phrase{% endif %}">{{ tok.text }}</span>
        {% elif tok.kind == "op" %}
          <span class="qop">{{ tok.text }}</span>
        {% elif tok.kind == "lparen" %}
          <span class="qparen">(</span>
        {% elif tok.kind == "rparen" %}
          <span class="qparen">)</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <!-- CATEGORY HEADER -->
  <div class="category-header">
    <h2>{{ cat.name }}</h2>
    <span class="count">{{ cat.count }} article{% if cat.count != 1 %}s{% endif %}</span>
  </div>

  {% if cat.groups %}
    <!-- DOMAIN FILTER BAR -->
    <div class="filter-bar">
      {% for g in cat.groups %}
      <a class="domain-pill {{ g.id }}" href="#d-{{ g.id }}-{{ loop.index }}">
        <span class="icon">{{ g.icon }}</span> {{ g.name }} <span class="num">{{ g.count }}</span>
      </a>
      {% endfor %}
    </div>

    <!-- DOMAIN SECTIONS -->
    {% for g in cat.groups %}
    <section class="domain {{ g.id }}" id="d-{{ g.id }}-{{ loop.index }}">
      <div class="domain-header">
        <span class="icon">{{ g.icon }}</span>
        <h3>{{ g.name }}</h3>
        <div class="accent-line"></div>
        <span class="num">{{ g.count }} article{% if g.count != 1 %}s{% endif %}</span>
      </div>

      <div class="grid">
        {% for entry in g.articles %}
        {% set art = entry.article %}
        {% set sm = entry.summary %}
        <article class="card {{ g.id }}{% if entry.featured %} featured{% endif %}{% if entry.wide %} wide{% endif %}">
          <div class="card-pills">
            <span class="pill-domain"><span class="icon">{{ g.icon }}</span> {{ g.name.split(' ')[0] }}</span>
            <span class="pill-type">{{ (sm.article_type or 'other') | replace('_', ' ') }}</span>
            {% if art.journal %}<span class="meta">{{ art.journal }}</span>{% endif %}
            {% if art.year %}<span class="meta">{{ art.year }}</span>{% endif %}
            <span class="meta">{{ art.source }}</span>
          </div>

          <h3 class="card-title">{{ art.title }}</h3>
          {% if art.authors_display %}
          <p class="card-authors">{{ art.authors_display }}</p>
          {% endif %}

          {% if entry.featured %}
            {# Featured card: show Aim + Key findings, both bullet lists #}
            <div class="section">
              <p class="label">Aim</p>
              {% if sm.aim %}
              <ul>{% for b in sm.aim %}<li>{{ b }}</li>{% endfor %}</ul>
              {% else %}<p class="placeholder">Not stated.</p>{% endif %}
            </div>
            <div class="section">
              <p class="label">Key findings</p>
              {% if sm.conclusions %}
              <ul>{% for b in sm.conclusions %}<li>{{ b }}</li>{% endfor %}</ul>
              {% else %}<p class="placeholder">Not stated.</p>{% endif %}
            </div>
          {% else %}
            {# Compact card: show only Key findings (or Aim if no findings) #}
            {% if sm.conclusions %}
            <div class="section">
              <p class="label">Key findings</p>
              <ul>{% for b in sm.conclusions[:2] %}<li>{{ b }}</li>{% endfor %}</ul>
            </div>
            {% elif sm.aim %}
            <div class="section">
              <p class="label">Aim</p>
              <ul>{% for b in sm.aim[:2] %}<li>{{ b }}</li>{% endfor %}</ul>
            </div>
            {% endif %}
          {% endif %}

          <div class="card-spacer"></div>
          <p class="doi">
            {% if art.doi %}
              <a href="https://doi.org/{{ art.doi }}">doi.org/{{ art.doi }}</a>
            {% elif art.url %}
              <a href="{{ art.url }}">{{ art.url }}</a>
            {% else %}
              <span class="placeholder">No DOI available.</span>
            {% endif %}
          </p>
        </article>
        {% endfor %}
      </div>
    </section>
    {% endfor %}
  {% else %}
    <div class="empty-note">No new articles this week.</div>
  {% endif %}
  {% endfor %}

  {% else %}
    <div class="empty-note">
      No enabled categories. Add Boolean queries to <code>config.yaml</code> to start receiving reports.
    </div>
  {% endif %}

  <footer>Generated automatically · {{ generated_at }}</footer>
</div>
</body>
</html>
